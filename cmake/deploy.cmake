# Copies the built mod into <DIVA_DIR>/mods/MultiDiva. Invoked post-build with -P.
# A running game locks MultiDiva.dll, so a failed copy is a warning, not a build error.
# Inputs: MOD_DIR, DIST_DIR, DLL, SERVER_EXE, BOT_EXE (optional: the Go server for "Host a server" and Miku Bot, if built)
file(MAKE_DIRECTORY "${MOD_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory "${DIST_DIR}" "${MOD_DIR}" RESULT_VARIABLE dist_result)
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${DLL}" "${MOD_DIR}" RESULT_VARIABLE dll_result)
set(server_result 0)
if(SERVER_EXE AND EXISTS "${SERVER_EXE}")
    file(MAKE_DIRECTORY "${MOD_DIR}/bin")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${SERVER_EXE}" "${MOD_DIR}/bin" RESULT_VARIABLE server_result)
endif()
set(bot_result 0)
if(BOT_EXE AND EXISTS "${BOT_EXE}")
    file(MAKE_DIRECTORY "${MOD_DIR}/bin")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${BOT_EXE}" "${MOD_DIR}/bin" RESULT_VARIABLE bot_result)
endif()
if(dist_result OR dll_result OR server_result OR bot_result)
    message(WARNING "MultiDiva built but NOT deployed to ${MOD_DIR} (is the game running?). Close the game and build again.")
else()
    message(STATUS "Deployed MultiDiva to ${MOD_DIR}")
endif()
